# Neon Postgres connection string
# Get this from your Neon dashboard (Connection Details -> "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/kwathu?sslmode=require

# Secret used to sign JWTs — generate a long random string for production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the API server listens on
PORT=4000

# Comma-separated list of allowed frontend origins (for CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# "production" enables secure cookies (requires HTTPS)
NODE_ENV=development
